# 密钥与本地产物，绝不入库
secrets/
*.key
*.env

# 临时产物
tmp_real/
req_slices/
# ext/ 是要入库的（协作者产出的文档、素材），只有 ext/tmp/ 是随手丢的临时区
ext/tmp/
runs/
*.log
__pycache__/
*.pyc
.venv/
node_modules/

# 真实报告照片的测试暂存目录（隐私红线，永不提交）
app/test/real/

# 比赛材料与本地导出，留在本机即可
docs/*
!docs/figs/
att1*.txt
att2*.txt
vendor/pdf-toolkit/
docs/ai-log/
